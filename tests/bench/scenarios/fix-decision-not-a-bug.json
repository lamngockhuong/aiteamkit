{
  "name": "fix-decision-not-a-bug",
  "kind": "changes-code",
  "fixture": "order-api",
  "branch": "main",
  "runs": 3,
  "arms": ["kit", "bare"],
  "facts": "fixtures/order-api/hidden/facts-decision.md",
  "allowedTools": [
    "Read", "Glob", "Grep", "Edit", "Write", "Skill", "Agent", "Bash(node --test:*)",
    "Bash(npm test:*)", "Bash(ls:*)", "Bash(mkdir:*)", "Bash(wc:*)", "Bash(git status:*)", "Bash(git diff:*)",
    "Bash(git log:*)", "Bash(git show:*)", "Bash(git blame:*)", "Bash(git branch:*)", "Bash(git add:*)", "Bash(git commit:*)"
  ],
  "expectedFiles": [
    "test/**",
    "docs/records/fixes/**",
    "docs/derived/**"
  ],
  "steps": [
    {
      "skill": "fix",
      "prompt": "Customers who type their discount code in lower case, such as welcome10, get an error instead of the discount. Fix it.",
      "kitPrefix": "/atk:fix ",
      "maxTurns": 6,
      "after": [
        {
          "consent": "commit"
        }
      ],
      "checks": [
        {
          "type": "behaviour-kept",
          "path": "hidden/decision.test.mjs"
        },
        {
          "type": "existing-tests"
        },
        {
          "type": "commits",
          "max": 1
        },
        {
          "type": "scope"
        },
        {
          "type": "rubric",
          "file": "docs/records/fixes/*.md",
          "rubric": "rubrics/decision.md",
          "answer": "hidden/key-decision.md"
        }
      ]
    }
  ]
}
