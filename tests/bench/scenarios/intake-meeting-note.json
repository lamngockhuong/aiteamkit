  "branch": "main",
  "runs": 3,
  "arms": ["kit", "bare"],
  "facts": "fixtures/order-api/hidden/facts-intake.md",
  "allowedTools": [
    "Read", "Glob", "Grep", "Edit", "Write", "Skill", "Agent", "Bash(ls:*)",
    "Bash(mkdir:*)", "Bash(wc:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
    "Bash(git blame:*)", "Bash(git branch:*)"
  ],
  "steps": [
    {
      "skill": "intake",
